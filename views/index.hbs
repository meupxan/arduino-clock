<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Часы</title>

    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"
        integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>

    <style>
        .bd-placeholder-img {
            font-size: 1.125rem;
            text-anchor: middle;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        @media (min-width: 768px) {
            .bd-placeholder-img-lg {
                font-size: 3.5rem;
            }
        }
    </style>

    <link href="floating-labels.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>

</head>

<body>
    <form class="form-signin">
        <div class="text-center mb-4">
            <img class="mb-4" src="https://i.gifer.com/152H.gif" alt="" width="72" height="72">
            <h1 class="h3 mb-3 font-weight-normal">Настройка часов</h1>
            <p>Настройка умных часов</a></p>
        </div>

        <div class="form-group">
            <input class="form-check-input" type="checkbox" value="" id="weather" name="weather"
                onclick="update('weather')" {{weather_settings.checked}}>
            <label class="form-check-label" for="weather">
                Отображение погоды
            </label>
            <input type="text" class="form-control" id="city" placeholder="Город" name="city" value="{{city}}"
                {{weather_settings.disabled}}>
        </div>

        <div class="form-group">
            <input class="form-check-input" type="checkbox" value="" id="h24" name="h24" {{h24}}>
            <label class="form-check-label" for="h24">
                24 часовой формат времени
            </label>
        </div>

        <div class="form-group">
            <input class="form-check-input" type="checkbox" value="" id="corona" name="corona" {{corona}}>
            <label class="form-check-label" for="corona">
                Отображение статистики коронавируса
            </label>
        </div>

        <div class="form-group">
            <input class="form-check-input" type="checkbox" value="" id="course" name="course" {{course}}>
            <label class="form-check-label" for="course">
                Курс доллара
            </label>
        </div>

        <a type="button" class="btn btn-primary" onclick="saveSettings()">Сохранить</a>

        <p class="mt-5 mb-3 text-muted text-center">&copy; 2021</p>
    </form>

    <script>
        function update(type) {
            if (type == "weather") $("#city").prop("disabled", !$("#" + type).is(':checked'));
        }

        function saveSettings() {
            $.post("api/save", {
                weather: {
                    city: $("#city").val(),
                    on: $("#weather").is(":checked")
                },
                corona: $("#corona").is(":checked"),
                course: $("#course").is(":checked"),
                h24: $("#h24").is(":checked")
            }, () => {
                Swal.fire({
                    position: 'center',
                    icon: 'success',
                    title: 'Сохранено',
                    showConfirmButton: false,
                    timer: 1000
                });
            });
        }
    </script>
</body>

</html>